    "-1은 계속 대기, 0은 대기 없음": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(-1 means always wait,0 means not)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "-1은 계속 대기, 0은 대기 없음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "(-1为一直等待，0为不等待)"
          }
        }
      }
    },
    "-1은 무한 반복, 0은 한 번 실행": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(-1 is infinite cycles)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "-1은 무한 반복, 0은 한 번 실행"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "(-1为无限次循环,0为循环1次)"
          }
        }
      }
    },
